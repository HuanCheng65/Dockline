/*
 Dockline 当前以简体中文为默认界面语言。

 凡是会显示给用户的文字都放在这里，由 Localized.swift 的 localized(_:) 取用。
 现有 Swift 源码中遗留的中文硬编码会逐步迁过来；新功能一律从这里取。
*/

"Dockline" = "Dockline";

/* MARK: - 活动状态（实时状态设计 §3） */

/* 等待：格子第二行的一个词，说明在等什么。四档取同一句式起头 */
"activity.waiting.question" = "待回答";
"activity.waiting.permission" = "待授权";
"activity.waiting.plan" = "待审阅";
"activity.waiting.input" = "待输入";

/* 终态：上报方未给摘要时的缺省说法 */
"activity.outcome.done" = "已完成";
"activity.outcome.failed" = "已失败";
"activity.outcome.quota" = "已限额";

/* 工具与工具之间模型正在生成下一步。这不是占位词，是当下真实的状态 */
"activity.thinking" = "生成中";

/* 面板只列末尾几步，这一行报出本轮的总数。%d 是步数 */
"activity.steps.count" = "本轮共 %d 步";

/* MARK: - 就地授权（实时状态设计 §4.7） */

"activity.ask.allow" = "允许";
"activity.ask.deny" = "拒绝";

/* 拒绝的理由，会原样进入模型的上下文，让它知道这一步为什么没走成 */
"activity.ask.denied" = "用户在 Dockline 中拒绝了这次操作。";

/* 面板只列得下前几行，这一行报出截掉了多少。%d 是行数 */
"activity.ask.more" = "另有 %d 行未显示";

/* 当前动作：动作名 + 作用对象。%1$@ 是动作名，%2$@ 是对象 */
"activity.action.format" = "%1$@ %2$@";

/* 动作名。上报送来的是归一化的动词，不是某个 agent 的工具名（见 dockctl/Verb.swift）；
   缺哪个就直接显示上报送来的原名，不猜 */
"activity.verb.read" = "读取";
"activity.verb.edit" = "编辑";
"activity.verb.write" = "写入";
"activity.verb.run" = "执行";
"activity.verb.search" = "搜索";
"activity.verb.fetch" = "访问网页";
"activity.verb.websearch" = "网络搜索";
"activity.verb.subtask" = "子任务";
"activity.verb.todo" = "更新待办";
